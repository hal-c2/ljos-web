#!/usr/bin/env bash
#MISE description="A static site from a directory with ljos-site.json (ljos-web build-site); ljos.dev itself is mise run site"
#MISE depends=["packages"]
#USAGE arg "<dir>" help="A directory with ljos-site.json"
#USAGE flag "--out <dir>" help="Where the site is written"
#USAGE flag "--qmlc <path>" help="The compiler; default this checkout's target/debug/qmlc"
#USAGE flag "--qt <dir>" var=#true help="An installed Qt's qml directory (more than once for several)"
#USAGE flag "--with <dir>" var=#true help="Another directory of QML modules the site imports (more than once for several)"
#USAGE flag "--styles <styles>" help="Whose style of the controls" {
#USAGE   choices "ljos" "qt"
#USAGE }
#USAGE flag "--prerender" help="Write each page's HTML at build time"
#USAGE flag "--pages <file>" help="A file naming the pages to build"
set -euo pipefail
# The compiler this checkout builds, unless one is named (--qmlc, or a QMLC
# other than this checkout's): then nothing is built for it. Every flag
# goes to ljos-web build-site, which reads them all.
root="$PWD"
# Paths are taken from where mise was run, and made whole: build-site runs
# in packages/runtime, the one place its bundler resolves its own
# `ljos-web/theme` import from (anywhere else a bundle fails to build).
from="${MISE_ORIGINAL_CWD:-$root}"
whole() {
  case $1 in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$from" "$1" ;;
  esac
}
# A --qmlc (or QMLC) with no slash is a command on PATH, so it stays a
# name.
whole_qmlc() {
  case $1 in
    */*) whole "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}
# A QMLC that is a path is the caller's too, and taken from where they are.
if [ -n "${QMLC:-}" ]; then QMLC=$(whole_qmlc "$QMLC") && export QMLC; fi
# Where build:compiler's cargo puts it, as cargo itself decides that:
# CARGO_TARGET_DIR, else build.target-dir in a cargo config, else target/.
target=$(cargo metadata --no-deps --format-version 1 --locked | node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(0, "utf8")).target_directory)')
named=false
for arg in "$@"; do
  case $arg in --qmlc | --qmlc=*) named=true ;; esac
done
if [ -n "${QMLC:-}" ] && [ "$QMLC" != "$target/debug/qmlc" ]; then named=true; fi
if [ "$named" = false ]; then
  mise run build:compiler
  export QMLC="$target/debug/qmlc"
  if [ ! -x "$QMLC" ]; then
    echo "build:site: build:compiler finished but there is no $QMLC; name a compiler with --qmlc PATH or QMLC=PATH" >&2
    exit 1
  fi
fi
args=()
pending=""
for arg in "$@"; do
  case $pending in
    path) args+=("$(whole "$arg")") ;;
    qmlc) args+=("$(whole_qmlc "$arg")") ;;
    word) args+=("$arg") ;;
    *)
      case $arg in
        --styles) args+=("$arg") && pending=word && continue ;;
        --qmlc=*) args+=("--qmlc=$(whole_qmlc "${arg#--qmlc=}")") ;;
        --out=* | --qt=* | --with=* | --pages=*) args+=("${arg%%=*}=$(whole "${arg#*=}")") ;;
        --qmlc) args+=("$arg") && pending=qmlc && continue ;;
        --out | --qt | --with | --pages) args+=("$arg") && pending=path && continue ;;
        -*) args+=("$arg") ;;
        *) args+=("$(whole "$arg")") ;;
      esac
      ;;
  esac
  pending=""
done
cd "$root/packages/runtime"
exec node bin/ljos-web.js build-site "${args[@]+"${args[@]}"}"
