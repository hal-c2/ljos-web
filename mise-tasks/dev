#!/usr/bin/env bash
#MISE description="Run something locally with Vite: the web example (default; QML recompiles as it is edited), the site, the Ljós-pages site or the gallery"
#MISE depends=["build:compiler", "packages"]
#USAGE arg "[what]" default="example" help="example (default): examples/web; site: the Astro site (site/); site-ljos: the site as Ljós pages, built then served; gallery: Qt's examples (gallery:serve). An option first (dev --port N) goes to the example's server"
#USAGE arg "[args]..." var=#true help="Passed on to the server (Vite, Astro), after WHAT"
set -euo pipefail

# WHAT is checked here, not by a choices list: usage would take a leading
# server option (dev --port N) as WHAT and refuse it.
what=example
if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
  what=$1
  shift
fi

case "$what" in
  example)
    exec pnpm --filter ljos-web-example-web dev "$@"
    ;;
  site)
    # The live blocks and the orbit demo load these in the page.
    mise run build:wasm-compiler
    mise run build:wasm-3d
    exec pnpm --filter ljos-site dev "$@"
    ;;
  site-ljos)
    mise run build:wasm-compiler
    mise run build:kernel
    mise run browser
    export QMLC="${QMLC:-${CARGO_TARGET_DIR:-$PWD/target}/debug/qmlc}"
    pnpm --filter ljos-site-ljos build
    exec pnpm --filter ljos-site-ljos serve "$@"
    ;;
  gallery)
    exec mise run gallery:serve "$@"
    ;;
  *)
    echo "dev: WHAT is example, site, site-ljos or gallery, not '$what'" >&2
    exit 2
    ;;
esac
