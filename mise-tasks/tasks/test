#!/usr/bin/env bash
#MISE description="Test the tasks' own logic with stand-in tools: setup and setup --check against the pinned Qt and the next minor"
set -euo pipefail

scratch="$(mktemp -d "${TMPDIR:-/tmp}/ljos-web-tasks-test.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT

# The stand-ins follow the pins setup reads, so moving one needs no change here.
rust=$(sed -n 's/^rust = { version = "\([0-9.]*\)".*/\1/p' mise.toml)
qt_pinned=$(git config -f .gitmodules --get submodule.corpus/qtdoc.branch)
newer="6.$((${qt_pinned#6.} + 1))"

# PATH holds only the stand-ins and the few system commands setup calls, so
# the machine's own Qt, Rust and optional tools never answer for them.
sys="$scratch/sys"
mkdir -p "$sys"
for cmd in bash cut env git grep sed; do
  ln -s "$(command -v "$cmd")" "$sys/$cmd"
done

# `stub <case> <name> <output>`: a tool that prints <output> and succeeds.
stub() {
  mkdir -p "$scratch/$1"
  printf '#!/bin/sh\necho "%s"\n' "$3" >"$scratch/$1/$2"
  chmod +x "$scratch/$1/$2"
}

# `qt <dir> <version>`: a Qt installed at <dir>, with a qml directory and the
# tools beside it that setup asks (qtpaths6 answers both of its questions).
qt() {
  mkdir -p "$1/bin" "$1/qml"
  # shellcheck disable=SC2016 # the stand-in expands $1 when it runs
  printf '#!/bin/sh\ncase "$1" in --query) echo "%s" ;; *) echo "%s" ;; esac\n' "$1/qml" "$2" >"$1/bin/qtpaths6"
  printf '#!/bin/sh\necho "Qml Runtime %s"\n' "$2" >"$1/bin/qml"
  chmod +x "$1/bin/qtpaths6" "$1/bin/qml"
}

failed=0
# `expect <case> <exit code> <text> [VAR=value]...`: setup --check, with that
# case's tools and variables, exits with <exit code> and prints <text>. Qt is
# only the reference, so no Qt it finds fails setup: that is only ever a note.
expect() {
  local c="$1" want="$2" text="$3" out code=0
  shift 3
  # The machine's /usr/lib/qt6/qml would answer for types unless a case names
  # its own.
  out="$(cd "${layout:-.}" && env -i HOME="$scratch" PATH="$scratch/$c:$sys" usage_check=true qt_system_qml="$scratch/none" "$@" bash mise-tasks/setup 2>&1)" || code=$?
  if [ "$code" != "$want" ] || [[ "$out" != *"$text"* ]] || [[ "$out" == *"setup: not the pinned version"* ]]; then
    echo "tasks:test: $c: setup exited $code, wanted $want and '$text'; it said:" >&2
    printf '%s\n' "$out" | sed 's/^/    /' >&2
    failed=1
  else
    echo "ok: $c"
  fi
}

for c in newer pinned qt5-only qt5-types mixed qml-only qml-named system unread themed; do
  stub "$c" rustup "wasm32-unknown-unknown"
  stub "$c" rustc "rustc $rust (stand-in)"
done
qt "$scratch/qt-newer" "$newer.1"
qt "$scratch/qt-pinned" "$qt_pinned.2"
ln -s "$scratch/qt-newer/bin/qml" "$scratch/newer/qml6"
ln -s "$scratch/qt-newer/bin/qtpaths6" "$scratch/newer/qtpaths6"
ln -s "$scratch/qt-pinned/bin/qml" "$scratch/pinned/qml6"
ln -s "$scratch/qt-pinned/bin/qtpaths6" "$scratch/pinned/qtpaths6"
# A qtpaths that names no qml directory leaves types nothing to read.
stub qt5-only qtpaths "5.15.19"
# A Qt 5 whose qtpaths names its qml directory is the Qt types would read.
mkdir -p "$scratch/qt-five/qml"
# shellcheck disable=SC2016 # the stand-in expands $1 when it runs
printf '#!/bin/sh\ncase "$1" in --query) echo "%s" ;; *) echo "5.15.19" ;; esac\n' "$scratch/qt-five/qml" >"$scratch/qt5-types/qtpaths"
chmod +x "$scratch/qt5-types/qtpaths"
# Qt 5's unsuffixed qtpaths beside Qt 6's qmake6: the Qt 6 answers for it.
mkdir -p "$scratch/qt-mixed/bin" "$scratch/qt-mixed/qml"
stub qt-mixed/bin qtpaths "5.15.19"
stub qt-mixed/bin qmake6 "$qt_pinned.2"
stub qml-only qml6 "Qml Runtime $newer.0"
# QML is what reference runs, whatever else on PATH answers.
ln -s "$scratch/qt-newer/bin/qml" "$scratch/qml-named/qml6"
stub qml-named qmake6 "$newer.1"
# Where /usr/lib/qt6/qml is, types reads it ahead of any qtpaths on PATH.
ln -s "$scratch/qt-pinned/bin/qtpaths6" "$scratch/system/qtpaths6"

# Another minor than the pin is a legitimate setup: a note naming the Qt
# found, the pin and how to install it, and setup passes.
expect newer 0 "setup: note, a Qt other than the pinned one"
expect newer 0 "types' Qt: Qt $newer.1 found ($scratch/qt-newer/qml); mise run types reads this Qt's types"
expect newer 0 "reference's qml: Qt $newer.1 found ($scratch/newer/qml6); mise run reference takes this Qt's pictures"
expect newer 0 "pinned: Qt $qt_pinned (.gitmodules' corpus/qtdoc branch)"
expect newer 0 "install Qt $qt_pinned (Qt's online installer, or aqt install-qt linux desktop \"\$(aqt list-qt linux desktop --spec $qt_pinned --latest-version)\" linux_gcc_64 -O ~/Qt) and set QML to its bin/qml"
expect pinned 0 "types' Qt: $scratch/qt-pinned/qml, the pinned Qt $qt_pinned"
expect pinned 0 "reference's qml: $scratch/pinned/qml6, the pinned Qt $qt_pinned"
expect qt5-only 0 "setup --check: found"
# Qt is optional here (no Qt at all is only skipped), so a Qt 5 is a note too.
expect qt5-types 0 "types' Qt: Qt 5.15.19 found ($scratch/qt-five/qml)"
expect mixed 0 "types' Qt: $scratch/qt-mixed/qml, the pinned Qt $qt_pinned" qt_system_qml="$scratch/qt-mixed/qml"
expect qml-only 0 "reference's qml: Qt $newer.0 found ($scratch/qml-only/qml6)"
expect qml-named 0 "reference's qml: $scratch/qt-pinned/bin/qml, the pinned Qt $qt_pinned" QML="$scratch/qt-pinned/bin/qml"
expect system 0 "types' Qt: Qt $newer.1 found ($scratch/qt-newer/qml)" qt_system_qml="$scratch/qt-newer/qml"
# A Qt found whose version nothing answers is said, not passed as pinned.
mkdir -p "$scratch/qt-unread/qml"
stub unread qml6 "Qml Runtime"
expect unread 0 "types' Qt ($scratch/qt-unread/qml): no qtpaths or qmake beside it gave a Qt version" qt_system_qml="$scratch/qt-unread/qml"
expect unread 0 "reference's qml ($scratch/unread/qml6) gave no Qt version" qt_system_qml="$scratch/qt-unread/qml"

# A desktop's Qt platform theme (gtk3) kills qml with no display; reference
# runs it without one, so setup asks it the same way.
mkdir -p "$scratch/themed"
# shellcheck disable=SC2016 # the stand-in expands its variables when it runs
printf '#!/bin/sh\n[ -z "$QT_QPA_PLATFORMTHEME" ] || { echo "cannot open display" >&2; exit 1; }\necho "Qml Runtime %s"\n' "$newer.2" >"$scratch/themed/qml6"
chmod +x "$scratch/themed/qml6"
expect themed 0 "reference's qml: Qt $newer.2 found ($scratch/themed/qml6)" QT_QPA_PLATFORMTHEME=gtk3

# setup itself, not --check, with another minor: it installs, then says the
# same note and passes. Run from a copy whose install steps are stand-ins.
layout="$scratch/layout"
mkdir -p "$layout/mise-tasks/tool" "$layout/mise-tasks/site"
cp mise-tasks/setup "$layout/mise-tasks/"
cp mise.toml .gitmodules "$layout/"
printf '#!/bin/sh\necho /stand-in/wasm-bindgen\n' >"$layout/mise-tasks/tool/wasm-bindgen"
printf '#!/bin/sh\necho /stand-in/docs\n' >"$layout/mise-tasks/site/docs"
chmod +x "$layout/mise-tasks/tool/wasm-bindgen" "$layout/mise-tasks/site/docs"
for tool in mise cargo pnpm node; do stub newer "$tool" "stand-in $tool"; done
expect newer 0 "setup: done" usage_check=false usage_no_corpus=true usage_no_browser=true
expect newer 0 "reference's qml: Qt $newer.1 found ($scratch/newer/qml6)" usage_check=false usage_no_corpus=true usage_no_browser=true
expect newer 0 "pinned: Qt $qt_pinned (.gitmodules' corpus/qtdoc branch)" usage_check=false usage_no_corpus=true usage_no_browser=true
# A missing need still fails: here the pinned Rust's wasm target.
stub newer rustup "none"
expect newer 1 "the wasm32-unknown-unknown target is not installed"
stub newer rustup "wasm32-unknown-unknown"
# So does a Rust that is not the pinned one, while the Qt beside it is a note.
stub newer rustc "rustc 1.0.0 (stand-in)"
expect newer 1 "setup: rustc on PATH is 1.0.0"
stub newer rustc "rustc $rust (stand-in)"
# A QML of its own, given relative to the checkout, is named where it is.
mkdir -p "$layout/rel-qt/bin"
printf '#!/bin/sh\necho "Qml Runtime %s"\n' "$newer.3" >"$layout/rel-qt/bin/qml"
chmod +x "$layout/rel-qt/bin/qml"
expect newer 0 "reference's qml: Qt $newer.3 found ($layout/rel-qt/bin/qml)" QML=./rel-qt/bin/qml
layout=""

if [ "$failed" != 0 ]; then
  echo "tasks:test: a case above failed" >&2
  exit 1
fi
echo "tasks:test: every case passed"
