#!/usr/bin/env bash
#MISE description="First run after a clone, and safe to run again: toolchains, the qtdoc submodule, Rust and JavaScript dependencies, wasm-bindgen, Playwright's Chromium; says what it skipped"
#USAGE flag "--no-corpus" help="Skip the corpus/qtdoc submodule (Qt's examples, for gallery, corpus and reference)"
#USAGE flag "--no-browser" help="Skip fetching Playwright's Chromium (the browser tests need it)"
#USAGE flag "--check" help="Install and fetch nothing (run it as mise run --skip-tools setup --check, or mise installs missing tools first); say what is found, and fail if Rust is not the pinned version; a Qt of another version is a note"
set -euo pipefail

check="${usage_check:-false}"
done_=()
skipped=()
noted=()

# Tools first: the rest runs on them. mise.toml pins Rust with the wasm
# target, Node and pnpm.
if [ "$check" != true ]; then
  mise install
fi
# mise installs Rust through rustup. mise.toml's activate_aggressive puts the
# pinned toolchain first on PATH inside `mise run`, ahead of a system rust;
# where that still is not what runs, every build after this would use the
# wrong compiler (no wasm32 sysroot), so setup stops here and says the fix.
pinned=$(sed -n 's/^rust = { version = "\([0-9.]*\)".*/\1/p' mise.toml)
if ! command -v rustup >/dev/null; then
  echo "setup: rustup not found; mise installs Rust $pinned through it. Install rustup (https://rustup.rs), then run 'mise run setup' again" >&2
  exit 1
fi
have=$(rustc --version 2>/dev/null | cut -d' ' -f2)
if [ "$have" != "$pinned" ]; then
  echo "setup: rustc on PATH is ${have:-missing} ($(command -v rustc || echo 'not found')), not the pinned $pinned. Run 'mise install rust@$pinned', and check that mise is activated in this shell (mise doctor)" >&2
  exit 1
fi
if ! rustup target list --installed 2>/dev/null | grep -qx wasm32-unknown-unknown; then
  echo "setup: the wasm32-unknown-unknown target is not installed for Rust $pinned; the wasm builds need it. Run 'rustup target add --toolchain $pinned wasm32-unknown-unknown'" >&2
  exit 1
fi

if [ "$check" = true ]; then
  done_+=("tools: Rust $have (+ wasm32-unknown-unknown), the pinned version; --check installed and fetched nothing")
else
  done_+=("tools: Rust $have (+ wasm32-unknown-unknown), Node $(node --version), pnpm $(pnpm --version) (mise install)")

  if [ "${usage_no_corpus:-false}" = true ]; then
    skipped+=("corpus/qtdoc (--no-corpus): gallery, corpus and reference fetch it when they run")
  else
    git submodule update --init --recursive --depth 1
    done_+=("submodules: corpus/qtdoc, Qt's examples (shallow)")
  fi

  # ljos-ui is named by ssh in Cargo.lock; it is public, so https fetches it
  # without a key. Once in cargo's cache, builds need no rewrite.
  # Appended after any GIT_CONFIG_* entries the caller has, which stay.
  n=${GIT_CONFIG_COUNT:-0}
  env GIT_CONFIG_COUNT=$((n + 1)) "GIT_CONFIG_KEY_$n=url.https://github.com/.insteadOf" "GIT_CONFIG_VALUE_$n=ssh://git@github.com/" \
    CARGO_NET_GIT_FETCH_WITH_CLI=true cargo fetch --locked
  done_+=("Rust dependencies, ljos-ui's compiler front end among them (cargo fetch)")

  pnpm install --frozen-lockfile
  done_+=("JavaScript packages (pnpm install)")

  bindgen="$(mise-tasks/tool/wasm-bindgen)"
  done_+=("wasm-bindgen, the version the crates pin: $bindgen")

  if [ "${usage_no_browser:-false}" = true ]; then
    skipped+=("Playwright's Chromium (--no-browser): every test task fetches it when it runs (mise run browser)")
  else
    mise-tasks/browser
    done_+=("Playwright's Chromium")
  fi
fi

# What setup does not install, only looks for.
if ! command -v qml >/dev/null && ! command -v qml6 >/dev/null; then
  skipped+=("Qt 6's qml tool not found: mise run reference cannot take Qt's pictures (install qt6-declarative); the gallery still compares with corpus/reference")
fi

# The Qt the corpus is pinned to: corpus/qtdoc tracks qtdoc's branch of that
# minor, and mise run reference and mise run types read Qt's own answers for
# it. A Qt of another minor draws and types those examples differently, but
# Qt is only the reference: that is a working setup, so it is a note.
qt_pinned=$(git config -f .gitmodules --get submodule.corpus/qtdoc.branch)
qt_from="the pinned Qt $qt_pinned (.gitmodules' corpus/qtdoc branch)"
# aqt names a host and an architecture; these are Qt 6.7 and later's.
case "$(uname -s)/$(uname -m)" in
  Darwin/*) aqt_host=mac aqt_arch=clang_64 ;;
  */aarch64 | */arm64) aqt_host=linux_arm64 aqt_arch=linux_gcc_arm64 ;;
  *) aqt_host=linux aqt_arch=linux_gcc_64 ;;
esac
qt_get="install Qt $qt_pinned (Qt's online installer, or aqt install-qt $aqt_host desktop \"\$(aqt list-qt $aqt_host desktop --spec $qt_pinned --latest-version)\" $aqt_arch -O ~/Qt)"
# `qt_note <task's Qt> <version> <where> <what it does with it> <then>`: the
# Qt found, the pin, and the one line that gets the pinned one.
qt_note() {
  noted+=("$1: Qt $2 found ($3); $4
      pinned: Qt $qt_pinned (.gitmodules' corpus/qtdoc branch)
      for the pinned Qt: $qt_get $5")
}
# types reads this directory first when it is there (tasks:test points it
# at a stand-in).
qt_system_qml="${qt_system_qml:-/usr/lib/qt6/qml}"
# `qt_answer <tool> <flags>...`: the Qt version in what the tool answers, or
# nothing. A Qt 5 answers too, and is a Qt of another version.
qt_answer() {
  local out
  out="$("$@" 2>/dev/null || true)"
  if [[ "$out" =~ (^|[^0-9])([0-9]+\.[0-9]+\.[0-9]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[2]}"
  fi
}
# `qt_of_bin <dir>`: the version of the Qt whose bin directory is <dir>. A
# distribution can keep Qt 5's unsuffixed qtpaths beside Qt 6's qmake6, so an
# answer of the pinned major wins over the first answer of another.
qt_of_bin() {
  local ask version first=""
  for ask in "qtpaths6 --qt-version" "qtpaths --qt-version" "qmake6 -query QT_VERSION" "qmake -query QT_VERSION"; do
    [ -x "$1/${ask%% *}" ] || continue
    # shellcheck disable=SC2086 # the flags are a word list
    version="$(qt_answer "$1/${ask%% *}" ${ask#* })"
    case "$version" in
      "") ;;
      "${qt_pinned%%.*}".*)
        printf '%s\n' "$version"
        return
        ;;
      *) first="${first:-$version}" ;;
    esac
  done
  [ -z "$first" ] || printf '%s\n' "$first"
}
# Each task's Qt, found the way that task finds it.
# reference (corpus/reference.mjs): QML, else qml6, else qml. It runs them
# without the desktop's Qt platform theme, which (gtk3) kills qml when there
# is no display, so setup asks them the same way.
unset QT_QPA_PLATFORMTHEME
qt_qml="${QML:-}"
# A path of its own (./qt/bin/qml) is read from here, as reference reads it.
case "$qt_qml" in
  */*) [[ "$qt_qml" == /* ]] || qt_qml="$PWD/${qt_qml#./}" ;;
esac
if [ -z "$qt_qml" ]; then
  for tool in qml6 qml; do
    if command -v "$tool" >/dev/null && QT_QPA_PLATFORM=offscreen "$tool" --help >/dev/null 2>&1; then
      qt_qml="$tool"
      break
    fi
  done
fi
if [ -n "$qt_qml" ]; then
  # qml makes its GUI application before it reads --version, so on a host
  # with no display it would answer nothing without the offscreen platform.
  version="$(QT_QPA_PLATFORM=offscreen qt_answer "$qt_qml" --version)"
  where="$(command -v "$qt_qml" || echo "$qt_qml")"
  case "$version" in
    "") skipped+=("reference's qml ($where) gave no Qt version for --version, so setup cannot say whether it is the pinned Qt $qt_pinned: set QML to Qt $qt_pinned's bin/qml to be sure") ;;
    "$qt_pinned".*) done_+=("reference's qml: $where, $qt_from") ;;
    *) qt_note "reference's qml" "$version" "$where" "mise run reference takes this Qt's pictures" "and set QML to its bin/qml" ;;
  esac
fi
# types (without --qt): /usr/lib/qt6/qml when it is there, else the qml
# directory qtpaths6 or qtpaths names.
qt_types="" version=""
if [ -d "$qt_system_qml" ]; then
  qt_types="$qt_system_qml"
  version="$(qt_of_bin "$qt_system_qml/../bin")"
else
  for tool in qtpaths6 qtpaths; do
    command -v "$tool" >/dev/null || continue
    dir=$("$tool" --query QT_INSTALL_QML 2>/dev/null || true)
    if [ -n "$dir" ] && [ -d "$dir" ]; then
      qt_types="$dir"
      version="$(qt_answer "$tool" --qt-version)"
      break
    fi
  done
fi
case "$qt_types:$version" in
  :) ;;
  *:) skipped+=("types' Qt ($qt_types): no qtpaths or qmake beside it gave a Qt version, so setup cannot say whether it is the pinned Qt $qt_pinned: run mise run types --qt with Qt $qt_pinned's qml directory to be sure") ;;
  *":$qt_pinned".*) done_+=("types' Qt: $qt_types, $qt_from") ;;
  *) qt_note "types' Qt" "$version" "$qt_types" "mise run types reads this Qt's types" "and run mise run types --qt <its qml directory>" ;;
esac

if ! command -v sway >/dev/null; then
  skipped+=("sway not found: mise run reference draws examples with shader effects without them")
fi
if ! pkg-config --exists fontconfig 2>/dev/null; then
  skipped+=("fontconfig's headers not found (pkg-config fontconfig): test:wasm-counter and test:wasm-gauge build a desktop app with them (install libfontconfig1-dev or fontconfig-devel)")
fi
# The docs both sites are built from: LJOS_DOCS_DIR, else ljos-ui's
# docs/site at the commit site/ljos-ui.sha pins, fetched into a cache.
# --check fetches nothing, so it leaves them to site:docs.
if [ "$check" != true ]; then
  if docs=$(mise-tasks/site/docs); then
    done_+=("ljos-ui docs for the sites (site:docs): $docs")
  else
    skipped+=("ljos-ui's docs could not be fetched (said above): mise run site and dev site fetch them when they run, or set LJOS_DOCS_DIR to a ljos-ui docs/site")
  fi
fi
if ! command -v gh >/dev/null; then
  skipped+=("gh not found: mise run deploy dispatches the site workflow with it")
fi

echo
if [ "$check" = true ]; then
  echo "setup --check: found"
else
  echo "setup: done"
fi
for line in "${done_[@]}"; do echo "  - $line"; done
if [ "${#skipped[@]}" -gt 0 ]; then
  echo "setup: skipped"
  for line in "${skipped[@]}"; do echo "  - $line"; done
fi
if [ "${#noted[@]}" -gt 0 ]; then
  echo "setup: note, a Qt other than the pinned one (this setup works; what is compared with Qt may differ from the pin's)"
  for line in "${noted[@]}"; do echo "  - $line"; done
fi
echo
# Qt is only the reference, so neither setup nor --check fails on its
# version: what fails is Rust, above, which every build needs.
if [ "$check" = true ]; then
  exit 0
fi
echo "next: mise run site (ljos.dev, live), mise run dev (the web example), mise run test, mise tasks for the rest"
