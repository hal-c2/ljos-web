#!/usr/bin/env bash
#MISE description="A Rust Counter bound from QML, in a browser, faces generated (docs/LJOS_WEB.md A22)"
#MISE depends=["build:compiler", "browser"]
set -euo pipefail

cd examples/wasm-counter

# The tool that makes JavaScript of what wasm-bindgen wrote into the .wasm.
bindgen="$(../../mise-tasks/tool/wasm-bindgen)"

cargo test
WASM_BINDGEN="$PWD/$bindgen" node ../../packages/runtime/bin/ljos-web.js faces .

pnpm --filter ljos-web-example-wasm-counter test "$@"
