#!/usr/bin/env bash
#MISE description="Native visual types from their Rust, in a browser, against the desktop's picture (docs/LJOS_WEB.md A22)"
#MISE depends=["build:compiler", "browser"]
set -euo pipefail

cd examples/wasm-gauge

bindgen=../wasm-counter/.tools/wasm-bindgen-0.2.129-x86_64-unknown-linux-musl/wasm-bindgen
if [ ! -x "$bindgen" ]; then
  mkdir -p ../wasm-counter/.tools
  curl -fsSL https://github.com/rustwasm/wasm-bindgen/releases/download/0.2.129/wasm-bindgen-0.2.129-x86_64-unknown-linux-musl.tar.gz \
    | tar xz -C ../wasm-counter/.tools
fi

out="${LJOS_GAUGE_PICTURES:-picture-out}"
mkdir -p "$out"
for scene in "Gauges 320 120" "Dials 240 240" "Label 240 80"; do
  read -r name width height <<<"$scene"
  cargo run --features picture --bin picture -- "$name" "$width" "$height" "$out/$name.desktop.png"
done
WASM_BINDGEN="$(realpath "$bindgen")" node ../../packages/runtime/bin/ljos-web.js faces .

pnpm --filter ljos-web-example-wasm-gauge test "$@"
