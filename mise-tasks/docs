#!/usr/bin/env bash
#MISE description="Build the API docs of every crate (cargo doc) and print where to open them; the docs people read are ljos.dev's (mise run site)"
#MISE depends=["tools"]
#USAGE flag "--open" help="Open the docs in a browser when built"
set -euo pipefail
args=(doc --no-deps --workspace --locked)
[ "${usage_open:-false}" = true ] && args+=(--open)
cargo "${args[@]}"
# Where cargo wrote them, as cargo itself decides it: CARGO_TARGET_DIR,
# else build.target-dir in a cargo config, else target/.
target=$(cargo metadata --no-deps --format-version 1 --locked | node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(0, "utf8")).target_directory)')
index="$target/doc/ljos_web/index.html"
if [ ! -f "$index" ]; then
  echo "docs: cargo doc finished but wrote no $index" >&2
  exit 1
fi
echo "docs: open $index (each crate has its own $target/doc/<crate>/index.html)"
